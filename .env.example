# --- Storage -------------------------------------------------------------
# Postgres connection string. Required in production; without it data is kept
# in .data/store.json (temporary on Vercel).
DATABASE_URL=

# --- Console access ------------------------------------------------------
# Either one shared password…
ADMIN_PASSWORD=
# …or named team logins (names appear on follow-up activity): "Ada:pass1,Musa:pass2"
ADMIN_USERS=
# Long random string used to sign console sessions.
ADMIN_SESSION_SECRET=

# --- Notifications (optional, via resend.com) ----------------------------
RESEND_API_KEY=
# Comma-separated list of team emails to notify of new enquiries
NOTIFY_EMAIL=
# Verified sender, e.g. "Orbitech <hello@yourdomain.com>"
RESEND_FROM=
# "true" to also send the client an acknowledgement email
RESEND_ACK_CLIENT=false

# --- Public contact details ----------------------------------------------
NEXT_PUBLIC_SITE_URL=https://orbitech-tax-compliance-n4yz.vercel.app
NEXT_PUBLIC_CONTACT_PHONE=+234 703 781 9477
NEXT_PUBLIC_WHATSAPP=2347037819477
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=
